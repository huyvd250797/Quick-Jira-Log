# Bắt buộc: chuỗi bí mật tối thiểu 32 ký tự để mã hóa Jira session trong HttpOnly cookie.
APP_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Tùy chọn. Mặc định 12 giờ.
SESSION_MAX_AGE_SECONDS=43200

# Tùy chọn - khuyến nghị khi app chạy production trên nhiều Vercel Serverless Instance.
# Dùng Upstash Redis hoặc Vercel KV REST để giữ idempotency/rate-limit/cache xuyên instance.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# Hoặc:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Tùy chọn: khi WorklogPRO có nhiều thuộc tính trùng tên Over Time hoặc tài khoản không đọc được danh sách /attr.
# Với /attr bị chặn, chỉ dùng ID do quản trị Jira xác nhận; quyền đọc/sửa worklog vẫn được Jira kiểm tra.
# Mặc định app tự tìm checkbox BOOL có tên Over Time / Over Time? / Overtime.
# ID thuộc tính WorklogPRO, không phải customfield Jira. Không cần token riêng.
# WORKLOGPRO_OVERTIME_ATTRIBUTE_ID=1

# Tùy chọn: ID custom field "Sub-task Type" trên Jira (khác Issue Type / issuetype).
# Mặc định tự tìm tên Sub-task Type qua GET /rest/api/2/field.
# Chỉ đặt nếu Jira có nhiều trường trùng tên hoặc endpoint /field bị giới hạn.
# Dùng ID thật do quản trị Jira xác nhận; không dùng một ID ví dụ bất kỳ.
# JIRA_SUBTASK_TYPE_FIELD_ID=customfield_<ID-thuc-te>
